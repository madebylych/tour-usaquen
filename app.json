{
  "expo": {
    "name": "Tour Usaquén",
    "slug": "tour-usaquen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación para mostrarte dónde estás en el mapa y qué lugares del tour tienes cerca."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-sqlite"
    ],
    "scheme": "tourusaquen"
  }
}
