{
  "expo": {
    "name": "Tour Usaquén",
    "slug": "tour-usaquen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.madebylych.tourusaquen"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.madebylych.tourusaquen",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación para mostrarte dónde estás en el mapa y qué lugares del tour tienes cerca."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-sqlite"
    ],
    "scheme": "tourusaquen",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e05f9151-87a3-49ba-92b2-6e51afb0934d"
      }
    },
    "owner": "madebylych"
  }
}
